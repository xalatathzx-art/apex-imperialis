<section class="tab {{tab.cssClass}} navis-implant-mechanics" data-group="primary" data-tab="{{tab.id}}"
         data-navis-mechanics="1">

    <div class="navis-mech-intro">
        <span class="hint">{{localize "NAVIS.Implant.Mechanics.Hint"}}</span>
        <a class="navis-mech-add" data-action="navisAddGroup">
            <i class="fa-solid fa-plus"></i> {{localize "NAVIS.Implant.Mechanics.AddGroup"}}
        </a>
    </div>

    {{#if mechanics.empty}}
    <div class="navis-mech-empty">{{localize "NAVIS.Implant.Mechanics.Empty"}}</div>
    {{/if}}

    {{#each mechanics.groups}}
    <div class="navis-mech-group {{#if this.isOr}}or{{/if}}" data-group-id="{{this.id}}">

        <header class="navis-mech-group-head">
            <a class="navis-mech-op" data-action="navisToggleOperator" data-group-id="{{this.id}}">
                {{localize this.operatorLabel}}
            </a>
            <span class="hint">{{localize "NAVIS.Implant.Mechanics.OperatorHint"}}</span>
            <span class="spacer"></span>
            <a class="navis-mech-control" data-action="navisAddEntry" data-group-id="{{this.id}}"
               data-tooltip="{{localize 'NAVIS.Implant.Mechanics.AddEntry'}}">
                <i class="fa-solid fa-plus"></i>
            </a>
            <a class="navis-mech-control" data-action="navisDeleteGroup" data-group-id="{{this.id}}"
               data-tooltip="{{localize 'NAVIS.Implant.Mechanics.DeleteGroup'}}">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </header>

        {{#each this.entries}}
        {{!-- An entry is one line until it is asked to be more. That line is the
              whole entry said in Russian, built in mechanics/constructor.js out
              of the same fields the open entry edits, so a folded entry is read
              rather than guessed at. --}}
        <div class="navis-mech-entry{{#if this.open}} open{{/if}}" data-entry-id="{{this.id}}">

            <div class="navis-mech-head">
                <button type="button" class="navis-mech-toggle"
                        data-action="navisToggleEntry"
                        data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                        id="navis-mech-row-{{@root.sheetId}}-{{this.id}}"
                        aria-controls="navis-mech-body-{{@root.sheetId}}-{{this.id}}"
                        aria-expanded="{{#if this.open}}true{{else}}false{{/if}}"
                        data-tooltip="{{this.summary}}">
                    <i class="fa-solid fa-caret-right navis-caret" aria-hidden="true"></i>
                    <span class="summary">{{this.summary}}</span>
                    {{#if this.live}}
                    {{!-- Creating no Active Effect is the one thing about an
                          entry that is invisible everywhere else, so the folded
                          line keeps saying it. --}}
                    <i class="fa-solid fa-bolt navis-mech-live-mark" aria-hidden="true"
                       data-tooltip="{{localize 'NAVIS.Implant.Mechanics.Live'}}"></i>
                    {{/if}}
                </button>
                <a class="navis-mech-control" data-action="navisDeleteEntry"
                   data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                   data-tooltip="{{localize 'NAVIS.Implant.Mechanics.DeleteEntry'}}">
                    <i class="fa-solid fa-xmark"></i>
                </a>
            </div>

            <div class="navis-mech-body"
                 id="navis-mech-body-{{@root.sheetId}}-{{this.id}}"
                 role="region" aria-labelledby="navis-mech-row-{{@root.sheetId}}-{{this.id}}">
                <div class="navis-mech-fields">

                    <div class="navis-mech-row">
                        {{!-- Grouped by what a kind MEANS. Twenty kinds in one
                              flat list is a list read from the top every time;
                              six headed groups is a list aimed at. --}}
                        <select class="navis-mech-kind" data-navis-field="kind"
                                data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                                aria-label="{{localize 'NAVIS.Implant.Mechanics.Kind'}}">
                            {{#each this.kindGroups}}
                            <optgroup label="{{localize this.label}}">
                                {{#each this.options}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>
                                    {{localize this.label}}
                                </option>
                                {{/each}}
                            </optgroup>
                            {{/each}}
                        </select>

                        {{#if this.keyOptions}}
                        <select class="navis-mech-key" data-navis-field="key"
                                data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                            {{selectOptions this.keyOptions selected=this.key localize=true blank=""}}
                        </select>
                        {{/if}}

                        {{#if this.hasValue}}
                        {{#unless this.ladder}}
                        <input class="navis-mech-value" type="number" data-navis-field="value"
                               data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                               value="{{this.value}}">
                        {{/unless}}
                        <a class="navis-mech-ladder {{#if this.ladder}}on{{/if}}" data-action="navisToggleLadder"
                           data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                            <i class="fa-solid fa-layer-group"></i> {{localize "NAVIS.Implant.Mechanics.Ladder"}}
                        </a>
                        {{/if}}
                    </div>

                    {{!-- A value that changes with the implant's level. A level left blank reads as the ordinary one. --}}
                    {{#if this.ladder}}
                    <div class="navis-mech-levels">
                        {{#each this.levels}}
                        <div class="level {{#if this.ordinary}}ordinary{{/if}}">
                            <label>{{this.level}}</label>
                            <input type="number" data-navis-field="value" data-level="{{this.level}}"
                                   data-group-id="{{../groupId}}" data-entry-id="{{../id}}"
                                   value="{{this.value}}">
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                    {{!-- A granted trait or talent, held by reference so it stays the compendium's. --}}
                    {{#if this.isDrop}}
                    <div class="navis-mech-drop" data-navis-drop="{{this.dropType}}"
                         data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                        {{#if this.sourceUuid}}
                        <a class="navis-mech-source" data-action="navisOpenSource" data-uuid="{{this.sourceUuid}}">
                            <img src="{{this.sourceImg}}" alt="">
                            <span>{{this.sourceName}}</span>
                        </a>
                        <a class="navis-mech-control" data-action="navisClearSource"
                           data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                           data-tooltip="{{localize 'NAVIS.Implant.Mechanics.Clear'}}">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                        {{else}}
                        <span class="hint">{{localize this.dropHint}}</span>
                        {{/if}}
                    </div>
                    {{/if}}

                    {{#if this.isTestMod}}
                    <div class="navis-mech-row sub">
                        <div class="field">
                            <label>{{localize "NAVIS.Implant.Mechanics.Skill"}}</label>
                            <select data-navis-field="skill"
                                    data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                                {{selectOptions @root.mechanics.skillOptions selected=this.skill localize=true
                                                blank=(localize "NAVIS.Implant.Mechanics.AnySkill")}}
                            </select>
                        </div>
                        <div class="field narrow">
                            <label>{{localize "NAVIS.Implant.Mechanics.Advantage"}}</label>
                            {{!-- Written out rather than built from an object: the order is the book's. --}}
                            <select data-navis-field="advantage"
                                    data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                                {{#each this.advantageOptions}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>
                                    {{localize this.label}}
                                </option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                    {{/if}}

                    {{!-- Which attacks the modifier narrows to. The stored value is
                          exactly what compile.js's guard tests, so the author's
                          choice and the generated script cannot drift apart. --}}
                    {{#if this.isAttack}}
                    <div class="navis-mech-row sub">
                        <div class="field">
                            <label>{{localize "NAVIS.Implant.Mechanics.AttackType"}}</label>
                            <select data-navis-field="attackType" aria-label="{{localize 'NAVIS.Implant.Mechanics.AttackType'}}"
                                    data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                                {{#each this.attackTypeOptions}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>
                                    {{localize this.label}}
                                </option>
                                {{/each}}
                            </select>
                        </div>
                        {{#if this.hasAdvantage}}
                        <div class="field narrow">
                            <label>{{localize "NAVIS.Implant.Mechanics.Advantage"}}</label>
                            <select data-navis-field="advantage"
                                    aria-label="{{localize 'NAVIS.Implant.Mechanics.Advantage'}}"
                                    data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                                {{#each this.advantageOptions}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>
                                    {{localize this.label}}
                                </option>
                                {{/each}}
                            </select>
                        </div>
                        {{/if}}
                    </div>
                    {{/if}}

                    {{!-- A trait written onto whatever weapon this implant grants.
                          The value box appears only for impmal's eight traits that
                          take one — a number typed against the other thirteen is
                          dropped when the weapon is built. --}}
                    {{#if this.isWeaponTrait}}
                    <div class="navis-mech-row sub">
                        <div class="field">
                            <label>{{localize "NAVIS.Implant.Mechanics.WeaponTrait"}}</label>
                            <select data-navis-field="traitKey" aria-label="{{localize 'NAVIS.Implant.Mechanics.WeaponTrait'}}"
                                    data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                                {{selectOptions this.traitOptions selected=this.traitKey localize=true blank=""}}
                            </select>
                        </div>
                        {{#if this.traitHasValue}}
                        <div class="field narrow">
                            <label>{{localize "NAVIS.Implant.Mechanics.TraitValue"}}</label>
                            <input type="text" data-navis-field="traitValue" aria-label="{{localize 'NAVIS.Implant.Mechanics.TraitValue'}}"
                                   data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                                   value="{{this.traitValue}}">
                        </div>
                        {{/if}}
                    </div>
                    {{/if}}

                    {{#if this.isCondition}}
                    <div class="navis-mech-row sub">
                        <div class="field">
                            <label>{{localize "NAVIS.Implant.Mechanics.Condition"}}</label>
                            <select data-navis-field="condition" aria-label="{{localize 'NAVIS.Implant.Mechanics.Condition'}}"
                                    data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}">
                                {{selectOptions this.conditionOptions selected=this.condition localize=true blank=""}}
                            </select>
                        </div>
                    </div>
                    {{/if}}

                    {{!-- A weapon grown into the limb: impmal's own weapon fields,
                          typed here rather than dropped, because there is no
                          compendium document for a set of claws that exists only
                          as part of this implant. Category, spec and range follow
                          the attack type, exactly as impmal's weapon sheet does. --}}
                    {{#if this.isProfile}}
                    {{#with this.profile}}
                    <div class="navis-mech-profile">
                        <div class="navis-mech-row sub">
                            <div class="field wide">
                                <label>{{localize "NAVIS.Implant.Mechanics.WeaponName"}}</label>
                                <input type="text" data-navis-field="profile.name" aria-label="{{localize 'NAVIS.Implant.Mechanics.WeaponName'}}"
                                       data-group-id="{{../groupId}}" data-entry-id="{{../id}}"
                                       value="{{this.name}}"
                                       placeholder="{{localize 'NAVIS.Implant.Mechanics.WeaponNameHint'}}">
                            </div>
                            <div class="field narrow">
                                <label>{{localize "NAVIS.Implant.Mechanics.AttackType"}}</label>
                                <select data-navis-field="profile.attackType" aria-label="{{localize 'NAVIS.Implant.Mechanics.AttackType'}}"
                                        data-group-id="{{../groupId}}" data-entry-id="{{../id}}">
                                    {{selectOptions this.attackTypeOptions selected=this.attackType localize=true}}
                                </select>
                            </div>
                        </div>

                        <div class="navis-mech-row sub">
                            <div class="field">
                                <label>{{localize "NAVIS.Implant.Mechanics.WeaponCategory"}}</label>
                                <select data-navis-field="profile.category" aria-label="{{localize 'NAVIS.Implant.Mechanics.WeaponCategory'}}"
                                        data-group-id="{{../groupId}}" data-entry-id="{{../id}}">
                                    {{selectOptions this.categoryOptions selected=this.category localize=true blank=""}}
                                </select>
                            </div>
                            <div class="field">
                                <label>{{localize "NAVIS.Implant.Mechanics.WeaponSpec"}}</label>
                                <select data-navis-field="profile.spec" aria-label="{{localize 'NAVIS.Implant.Mechanics.WeaponSpec'}}"
                                        data-group-id="{{../groupId}}" data-entry-id="{{../id}}">
                                    {{selectOptions this.specOptions selected=this.spec localize=true blank=""}}
                                </select>
                            </div>
                            {{#if this.ranged}}
                            <div class="field">
                                <label>{{localize "NAVIS.Implant.Mechanics.WeaponRange"}}</label>
                                <select data-navis-field="profile.range" aria-label="{{localize 'NAVIS.Implant.Mechanics.WeaponRange'}}"
                                        data-group-id="{{../groupId}}" data-entry-id="{{../id}}">
                                    {{selectOptions this.rangeOptions selected=this.range localize=true blank=""}}
                                </select>
                            </div>
                            {{/if}}
                        </div>

                        <div class="navis-mech-row sub">
                            <div class="field narrow">
                                <label>{{localize "NAVIS.Implant.Mechanics.WeaponDamage"}}</label>
                                <input type="text" data-navis-field="profile.damage.base" aria-label="{{localize 'NAVIS.Implant.Mechanics.WeaponDamage'}}"
                                       data-group-id="{{../groupId}}" data-entry-id="{{../id}}"
                                       value="{{this.damageBase}}">
                            </div>
                            <div class="field narrow">
                                <label>{{localize "NAVIS.Implant.Mechanics.WeaponDamageChar"}}</label>
                                <select data-navis-field="profile.damage.characteristic" aria-label="{{localize 'NAVIS.Implant.Mechanics.WeaponDamageChar'}}"
                                        data-group-id="{{../groupId}}" data-entry-id="{{../id}}">
                                    {{selectOptions this.characteristicOptions selected=this.damageCharacteristic
                                                    localize=true blank=""}}
                                </select>
                            </div>
                        </div>

                        {{!-- Checkboxes with their own labels, so the tick is never
                              the only thing that says what it means. --}}
                        <div class="navis-mech-row sub navis-mech-flags">
                            <label class="check">
                                <input type="checkbox" data-navis-field="profile.damage.SL"
                                       data-group-id="{{../groupId}}" data-entry-id="{{../id}}"
                                       {{checked this.damageSL}}>
                                {{localize "NAVIS.Implant.Mechanics.WeaponDamageSL"}}
                            </label>
                            <label class="check">
                                <input type="checkbox" data-navis-field="profile.damage.ignoreAP"
                                       data-group-id="{{../groupId}}" data-entry-id="{{../id}}"
                                       {{checked this.damageIgnoreAP}}>
                                {{localize "NAVIS.Implant.Mechanics.WeaponIgnoreAP"}}
                            </label>
                        </div>
                    </div>
                    {{/with}}
                    {{/if}}

                    {{#if this.isScript}}
                    <div class="navis-mech-script">
                        <textarea data-navis-field="script" rows="4"
                                  data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                                  placeholder="{{localize 'NAVIS.Implant.Mechanics.ScriptHint'}}">{{this.script}}</textarea>
                        <div class="field">
                            <label>{{localize "NAVIS.Implant.Mechanics.Throttle"}}</label>
                            <input type="text" data-navis-field="throttle"
                                   data-group-id="{{this.groupId}}" data-entry-id="{{this.id}}"
                                   value="{{this.throttle}}"
                                   placeholder="{{localize 'NAVIS.Implant.Mechanics.ThrottleHint'}}">
                        </div>
                    </div>
                    {{/if}}

                    {{!-- Live kinds are consulted while a test is prepared, so no Active Effect ever appears. --}}
                    {{#if this.live}}
                    <div class="navis-mech-live">
                        <i class="fa-solid fa-bolt"></i> {{localize "NAVIS.Implant.Mechanics.Live"}}
                    </div>
                    {{/if}}

                </div>
            </div>

        </div>
        {{/each}}

    </div>
    {{/each}}

</section>
